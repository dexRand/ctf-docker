#!/usr/bin/env bash
# Wrapper per il CTF Toolbox.
set -euo pipefail
cd "$(dirname "$0")"

if [[ ! -f .env ]]; then
  echo "[*] .env assente: lo creo da .env.example"
  cp .env.example .env
fi

usage() {
  cat <<'EOF'
Uso: ./ctf <comando>

  up [profilo...]   Avvia i tool core (+ i profili indicati)
  up-all            Avvia tutti i tool (core + tutti i profili)
  down              Ferma e rimuove i container
  status            Stato dei container
  logs [servizio]   Log in tempo reale
  list              Elenca i profili disponibili
  triage <file>     Deep triage: estrazione ricorsiva + cracking wordlist + flag hunt
  reports           URL dei report (FileBrowser)
  urls              Stampa gli URL dei servizi (porte da .env)
  open <servizio>   Apre un servizio nel browser (stegsuite|docs|dash|triage|reports|…)
  test              Regressione + challenge reali + verifica risposte
  ui-smoke          Smoke test della SPA con un browser headless (Docker)

Profili: web  recon  crypto  forensics  crack
Dashboard: http://localhost:19001
EOF
}

all_profiles=(web recon crypto forensics crack)

# port VARNAME default  ->  value from .env (or the default)
port() {
  local v=""
  [ -f .env ] && v="$(grep -E "^$1=" .env 2>/dev/null | tail -1 | cut -d= -f2 || true)"
  echo "${v:-$2}"
}

case "${1:-up}" in
  up)
    shift || true
    args=()
    for p in "$@"; do args+=(--profile "$p"); done
    echo "[*] Avvio tool core${*:+ + profili: $*}"
    docker compose "${args[@]}" up -d
    echo "[*] Dashboard: http://localhost:19001"
    ;;
  up-all)
    args=()
    for p in "${all_profiles[@]}"; do args+=(--profile "$p"); done
    echo "[*] Avvio di tutti i tool (puo' richiedere tempo: immagini pesanti)"
    docker compose "${args[@]}" up -d
    echo "[*] Dashboard: http://localhost:19001"
    ;;
  down)
    echo "[*] Fermo tutti i container (inclusi i profili)"
    args=()
    for p in "${all_profiles[@]}"; do args+=(--profile "$p"); done
    docker compose "${args[@]}" down
    ;;
  status|ps)
    args=()
    for p in "${all_profiles[@]}"; do args+=(--profile "$p"); done
    docker compose "${args[@]}" ps
    ;;
  logs)
    shift || true
    docker compose logs -f "$@"
    ;;
  list)
    printf 'Profili: %s\n' "${all_profiles[*]}"
    ;;
  triage)
    shift || true
    if [ $# -lt 1 ]; then
      echo "uso: ./ctf triage <file|cartella> [--no-crack] [-w <wordlist>] [--pattern <regex>] [--depth N]" >&2
      exit 1
    fi
    target="$1"; shift
    if [ ! -e "$target" ]; then
      echo "[x] non trovato: $target" >&2
      exit 1
    fi
    abs="$(realpath "$target")"
    profile_filebrowser="$(grep -q '^FILEBROWSER_PORT=' .env 2>/dev/null && grep '^FILEBROWSER_PORT=' .env | cut -d= -f2 || echo 19012)"
    echo "[*] Build/avvio del container triage..."
    docker compose up -d triage >/dev/null
    mkdir -p data
    echo "[*] Analisi di: $abs"
    ttyflag=()
    [ -t 0 ] || ttyflag=(-T)   # niente pseudo-TTY se stdin è una pipe
    docker compose run --rm --no-deps -i "${ttyflag[@]}" \
      -e HOST_UID="$(id -u)" -e HOST_GID="$(id -g)" \
      -v "$abs:/target:ro" triage triage /target "$@"
    echo
    echo "[*] Report: ./data/latest/report.md  (oppure http://localhost:${profile_filebrowser})"
    ;;
  reports)
    fb="$(port FILEBROWSER_PORT 19012)"
    docker compose up -d filebrowser >/dev/null
    echo "Report e file estratti: http://localhost:${fb}   (accesso libero, nessun login)"
    ;;
  urls|url)
    cat <<EOF
  Dashboard        http://localhost:$(port HOMEPAGE_PORT 19001)
  StegSuite        http://localhost:$(port STEGSUITE_PORT 19014)
  StegSuite API    http://localhost:$(port STEGSUITE_PORT 19014)/api/docs
  Triage           http://localhost:$(port TRIAGE_WEB_PORT 19013)
  Reports          http://localhost:$(port FILEBROWSER_PORT 19012)
  AperiSolve       http://localhost:$(port APERISOLVE_PORT 19000)
  CyberChef        http://localhost:$(port CYBERCHEF_PORT 19002)
  mitmweb          http://localhost:$(port MITMWEB_UI_PORT 19003)
  IT-Tools         http://localhost:$(port ITTOOLS_PORT 19011)
  ZAP              http://localhost:$(port ZAP_UI_PORT 19005)/zap   (profilo web)
  SpiderFoot       http://localhost:$(port SPIDERFOOT_PORT 19007)/spiderfoot/   (profilo recon)
  Wireshark        http://localhost:$(port WIRESHARK_HTTP_PORT 19008)   (profilo forensics)
  SageMath         http://localhost:$(port SAGEMATH_PORT 19010)   (profilo crypto)
EOF
    ;;
  open)
    shift || true
    case "${1:-stegsuite}" in
      dash|dashboard|home|homepage) url="http://localhost:$(port HOMEPAGE_PORT 19001)" ;;
      steg|stegsuite)               url="http://localhost:$(port STEGSUITE_PORT 19014)" ;;
      docs|api)                     url="http://localhost:$(port STEGSUITE_PORT 19014)/api/docs" ;;
      triage)                       url="http://localhost:$(port TRIAGE_WEB_PORT 19013)" ;;
      reports|files)                url="http://localhost:$(port FILEBROWSER_PORT 19012)" ;;
      *)                            url="$1" ;;  # consenti un URL esplicito
    esac
    echo "[*] ${url}"
    opener="$(command -v xdg-open || command -v open || true)"
    [ -n "$opener" ] && "$opener" "$url" >/dev/null 2>&1 || true
    ;;
  test)
    echo "[*] Avvio StegSuite..."
    docker compose up -d stegsuite >/dev/null
    cid="$(docker compose ps -q stegsuite)"
    [ -n "$cid" ] || { echo "[x] stegsuite non avviato" >&2; exit 1; }
    docker cp app/tests/ctf_regression.py "$cid":/tmp/ctf_regression.py >/dev/null
    docker cp app/tests/fixtures "$cid":/tmp/fixtures >/dev/null 2>&1 || true
    echo
    echo "== Regressione (fixture) =="
    docker exec -e FIXTURES_DIR=/tmp/fixtures "$cid" \
      /opt/stegsuite/venv/bin/python /tmp/ctf_regression.py
    echo
    echo "== Challenge reali =="
    ( cd app/tests && python3 real_challenges.py )
    echo
    echo "== Verifica risposte (writeup) =="
    ( cd app/tests && python3 verify_flags.py )
    ;;
  ui-smoke)
    echo "[*] Avvio StegSuite..."
    docker compose up -d stegsuite >/dev/null
    bash app/tests/ui_smoke.sh
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage
    exit 1
    ;;
esac
