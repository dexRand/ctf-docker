#!/usr/bin/env bash
# Wrapper per il CTF Toolbox.
set -euo pipefail
cd "$(dirname "$0")"

if [[ ! -f .env ]]; then
  echo "[*] .env assente: lo creo da .env.example"
  cp .env.example .env
fi

all_profiles=(web recon crypto forensics crack audio rev)

# envget VARNAME default  ->  value from .env (or the default); strips quotes
# and trailing comments, keeps any '=' inside the value
envget() {
  local v=""
  [ -f .env ] && v="$(grep -E "^$1=" .env 2>/dev/null | tail -1 | cut -d= -f2- || true)"
  v="${v%%[[:space:]]#*}"; v="${v%\"}"; v="${v#\"}"; v="${v%\'}"; v="${v#\'}"
  echo "${v:-$2}"
}
port() { envget "$@"; }

# StegSuite API for scan/test/mcp (port and key from .env)
export STEGSUITE="${STEGSUITE:-http://127.0.0.1:$(port STEGSUITE_PORT 19014)}"
export STEGSUITE_API_KEY="${STEGSUITE_API_KEY:-$(envget STEGSUITE_API_KEY "")}"

# --profile flags, one per line (read with mapfile)
profile_args() {
  local p
  for p in "$@"; do printf -- '--profile\n%s\n' "$p"; done
}

# every compose file and profile: core + the osint override
compose_all() {
  local files=(-f compose.yaml) prof=()
  [ -f osint/compose.yaml ] && files+=(-f osint/compose.yaml)
  mapfile -t prof < <(profile_args "${all_profiles[@]}")
  docker compose "${files[@]}" "${prof[@]}" "$@"
}

# Services: name | aliases | label | port var | default port | path | profile
# (one table for `urls` and `open`)
SERVICES="
dashboard|dash home homepage|Dashboard|HOMEPAGE_PORT|19001|/|core
stegsuite|steg|StegSuite (GUI)|STEGSUITE_PORT|19014|/|core
docs|api|StegSuite API docs|STEGSUITE_PORT|19014|/api/docs|core
reports|files data filebrowser|Data/reports (FileBrowser)|FILEBROWSER_PORT|19012|/|core
cyberchef|chef|CyberChef|CYBERCHEF_PORT|19002|/|core
mitm|mitmweb mitmproxy|mitmweb (password: MITMWEB_PASSWORD, default mitm)|MITMWEB_UI_PORT|19003|/|core
mitm-proxy|proxy|mitmproxy proxy|MITMPROXY_PORT|19004||core
it-tools|ittools|IT-Tools|ITTOOLS_PORT|19011|/|core
dork|dorks|Dork generator|DORK_PORT|19019|/|core
term|terminal|Terminale (ttyd + zellij: ctf, rev)|TERM_PORT|19022|/|core
zap||OWASP ZAP|ZAP_UI_PORT|19005|/zap|web
zap-proxy||ZAP proxy|ZAP_PROXY_PORT|19006||web
spiderfoot|recon|SpiderFoot|SPIDERFOOT_PORT|19007|/spiderfoot/|recon
wireshark|pcap|Wireshark|WIRESHARK_HTTP_PORT|19008|/|forensics
sagemath|sage|SageMath (token: ./ctf logs sagemath)|SAGEMATH_PORT|19010|/|crypto
hashtopolis|hashcat|Hashtopolis|HASHTOPOLIS_FRONTEND_PORT|19016|/|crack
whisper|audio stt|Whisper-WebUI|WHISPER_PORT|19017|/|audio
rev|elf pe apk|rev sandbox (terminale)|REV_PORT|19018|/|rev
rev-web|workbench|rev workbench (browser)|REV_WEB_PORT|19020|/|rev
shell|term|shell (terminale con pane)|SHELL_PORT|19021|/|rev
osint||OSINT (override osint/)|OSINT_PORT|19050|/|osint
"

service_url() {   # service_url <name or alias>  ->  URL (empty if unknown)
  local name alias label var def path prof
  while IFS='|' read -r name alias label var def path prof; do
    [ -z "$name" ] && continue
    if [ "$1" = "$name" ] || [[ " $alias " == *" $1 "* ]]; then
      echo "http://localhost:$(port "$var" "$def")${path}"
      return
    fi
  done <<< "$SERVICES"
}

open_url() {
  echo "[*] $1"
  local opener
  opener="$(command -v xdg-open || command -v open || true)"
  if [ -n "$opener" ]; then "$opener" "$1" >/dev/null 2>&1 || true; fi
}

# wait until StegSuite answers its health endpoint (max ~2 min)
wait_ready() {
  local _
  printf '[*] Attendo che StegSuite sia pronto'
  for _ in $(seq 1 60); do
    if curl -fsS "${STEGSUITE}/api/v1/health" >/dev/null 2>&1; then echo " ok"; return 0; fi
    printf '.'; sleep 2
  done
  echo " (non risponde ancora: ./ctf logs stegsuite)"
}

ready_banner() {
  cat <<EOF

  Pronto. Da qui:
    Dashboard   $(service_url dashboard)
    StegSuite   $(service_url stegsuite)     crea una CTF e trascina gli allegati
    API         $(service_url docs)
    IA (MCP)    ./ctf mcp
    Tutti       ./ctf urls
EOF
}

usage() {
  cat <<EOF
Uso: ./ctf <comando>

  up [profilo...]   Avvia i tool core (+ i profili indicati) e aspetta che siano pronti
  up-all            Avvia tutti i tool (core + tutti i profili)
  down              Ferma e rimuove i container (profili e osint inclusi)
  status            Stato dei container
  logs [servizio]   Log in tempo reale
  list              Elenca i profili disponibili
  reports|files     Apre FileBrowser su ./data (progetti, estratti, wordlist)
  urls              Stampa gli URL dei servizi (porte da .env)
  open <servizio>   Apre un servizio nel browser (nomi: ./ctf urls)
  mcp               Come collegare un'IA (Claude Code) alla suite via MCP
  dork [target]     Dork generator: query Google/GitHub/Shodan da un target.
                    \`--update\` scarica la Google Hacking Database (GHDB);
                    \`--ghdb <kw>\` la cerca; senza target apre la pagina web.
  dork-test         Self-test del dork generator
  pull <url>...     Scarica file (es. allegati di challenge online) in ./data/pull
  scan <file>...    Analizza file con StegSuite e stampa le flag
  test [opzioni]    Regressione + challenge reali (+ opzioni di real_challenges.py,
                    es. -j 3, --extra, --gaps) + verifica risposte
  ui-smoke          Smoke test della SPA con un browser headless (Docker)

Profili: ${all_profiles[*]}
Dashboard: $(service_url dashboard)
EOF
}

case "${1:-up}" in
  up)
    shift || true
    mapfile -t args < <(profile_args "$@")
    echo "[*] Avvio tool core${*:+ + profili: $*}"
    docker compose "${args[@]}" up -d
    wait_ready
    ready_banner
    ;;
  up-all)
    mapfile -t args < <(profile_args "${all_profiles[@]}")
    echo "[*] Avvio di tutti i tool (puo' richiedere tempo: immagini pesanti)"
    docker compose "${args[@]}" up -d
    wait_ready
    ready_banner
    ;;
  down)
    echo "[*] Fermo tutti i container (inclusi i profili)"
    compose_all down
    ;;
  status|ps)
    compose_all ps
    ;;
  logs)
    shift || true
    docker compose logs -f "$@"
    ;;
  list)
    printf 'Profili: %s\n' "${all_profiles[*]}"
    ;;
  reports|files)
    docker compose up -d filebrowser >/dev/null
    echo "Data e file estratti: $(service_url reports)   (accesso libero, nessun login)"
    ;;
  urls|url)
    while IFS='|' read -r name _alias label var def path prof; do
      [ -z "$name" ] && continue
      extra=""
      [ "$prof" != core ] && extra="   [profilo $prof]"
      printf '  %-12s %-44s %s%s\n' "$name" "http://localhost:$(port "$var" "$def")${path}" "$label" "$extra"
    done <<< "$SERVICES"
    ;;
  open)
    shift || true
    url="$(service_url "${1:-stegsuite}")"
    open_url "${url:-$1}"   # unknown name: treat it as an explicit URL
    ;;
  mcp)
    key_hdr=""
    # shellcheck disable=SC2016  # printed literally: the user's shell expands it
    [ -n "$STEGSUITE_API_KEY" ] && key_hdr=' --header "X-API-Key: $STEGSUITE_API_KEY"'
    cat <<EOF
StegSuite espone un server MCP: un'IA puo' creare CTF, caricare challenge,
lanciare l'autosolver, leggere flag/report/transcript, craccare, rilanciare tool.

  Claude Code:
    claude mcp add --transport http ctf ${STEGSUITE}/api/v1/mcp${key_hdr}

  Endpoint: ${STEGSUITE}/api/v1/mcp   (Streamable HTTP, stessa API key della REST API)
  Docs:     docs/API.md (sezione MCP)
EOF
    ;;
  dork)
    shift || true
    if [ "$#" -eq 0 ]; then
      python3 tools/dork/dork.py --build >/dev/null 2>&1 || true
      ghdb="config/dork/ghdb.json"
      if [ ! -f "$ghdb" ] || [ -n "$(find "$ghdb" -mtime +7 2>/dev/null)" ]; then
        echo "[*] Aggiorno la Google Hacking Database (circa una volta a settimana)…"
        python3 tools/dork/dork.py --update \
          || echo "[!] Sync GHDB non riuscita (offline?): la tab GHDB resterà vuota finché non fai './ctf dork --update'."
      fi
      docker compose up -d dork >/dev/null 2>&1 || true
      open_url "$(service_url dork)"
    else
      exec python3 tools/dork/dork.py "$@"
    fi
    ;;
  pull)
    shift || true
    [ "$#" -eq 0 ] && { echo "uso: ./ctf pull <url>..."; exit 1; }
    mkdir -p data/pull
    for u in "$@"; do
      u_path="${u%%\?*}"
      base="$(basename "${u_path%/}")"
      case "$base" in ""|*:*) base="download" ;; esac
      fn="data/pull/$base"
      n=1
      while [ -e "$fn" ]; do fn="data/pull/${n}_$base"; n=$((n + 1)); done   # never overwrite
      echo "[*] $u"
      if curl -fsSL -o "$fn" "$u"; then
        echo "    -> $fn ($(du -h "$fn" 2>/dev/null | cut -f1))"
        case "$fn" in
          *.tar.gz|*.tgz) tar -xzf "$fn" -C data/pull 2>/dev/null && echo "    estratto in data/pull/";;
          *.zip)          unzip -oq "$fn" -d data/pull 2>/dev/null && echo "    estratto in data/pull/";;
          *.7z)           7z x -y -odata/pull "$fn" >/dev/null 2>&1 && echo "    estratto in data/pull/";;
        esac
      else
        echo "    [x] download fallito"
      fi
    done
    echo "[i] analizza con: ./ctf scan <file>   ·   sfoglia: ./ctf reports"
    ;;
  scan)
    shift || true
    if [ "$#" -eq 0 ]; then echo "uso: ./ctf scan <file>..."; exit 1; fi
    docker compose up -d stegsuite >/dev/null 2>&1 || true
    wait_ready >/dev/null
    python3 tools/scan.py "$@"
    ;;
  dork-test)
    echo "== Dork generator: self-test =="
    python3 tools/dork/test_dork.py
    ;;
  test)
    shift || true
    echo "[*] Avvio StegSuite..."
    docker compose up -d stegsuite >/dev/null
    wait_ready
    cid="$(docker compose ps -q stegsuite)"
    [ -n "$cid" ] || { echo "[x] stegsuite non avviato" >&2; exit 1; }
    docker cp app/tests/ctf_regression.py "$cid":/tmp/ctf_regression.py >/dev/null
    docker cp app/tests/fixtures "$cid":/tmp/fixtures >/dev/null 2>&1 || true
    echo
    echo "== Regressione (fixture) =="
    docker exec -e FIXTURES_DIR=/tmp/fixtures -e PYTHONUNBUFFERED=1 "$cid" \
      /opt/stegsuite/venv/bin/python /tmp/ctf_regression.py
    echo
    echo "== Challenge reali =="
    ( cd app/tests && PYTHONUNBUFFERED=1 python3 real_challenges.py "$@" )
    echo
    echo "== Verifica risposte (writeup) =="
    ( cd app/tests && PYTHONUNBUFFERED=1 python3 verify_flags.py )
    ;;
  ui-smoke)
    echo "[*] Avvio StegSuite..."
    docker compose up -d stegsuite >/dev/null
    bash app/tests/ui_smoke.sh
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage
    exit 1
    ;;
esac
