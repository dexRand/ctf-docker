{
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.panel.defaultLocation": "bottom",
  "workbench.colorCustomizations": {
    "editor.background": "#0c0e10",
    "editor.foreground": "#d7dde3",
    "editorLineNumber.foreground": "#66717c",
    "editorLineNumber.activeForeground": "#45e08c",
    "editorCursor.foreground": "#45e08c",
    "editor.selectionBackground": "#143325",
    "editor.lineHighlightBackground": "#14171a",
    "sideBar.background": "#14171a",
    "sideBar.border": "#262b31",
    "sideBarSectionHeader.background": "#1a1e22",
    "activityBar.background": "#0c0e10",
    "activityBar.foreground": "#45e08c",
    "activityBar.inactiveForeground": "#66717c",
    "activityBar.border": "#262b31",
    "activityBarBadge.background": "#45e08c",
    "activityBarBadge.foreground": "#0c0e10",
    "titleBar.activeBackground": "#0c0e10",
    "titleBar.inactiveBackground": "#0c0e10",
    "titleBar.border": "#262b31",
    "statusBar.background": "#14171a",
    "statusBar.foreground": "#aab4bd",
    "statusBar.border": "#262b31",
    "statusBarItem.remoteBackground": "#45e08c",
    "statusBarItem.remoteForeground": "#0c0e10",
    "tab.activeBackground": "#0c0e10",
    "tab.inactiveBackground": "#14171a",
    "tab.activeBorderTop": "#45e08c",
    "tab.border": "#262b31",
    "editorGroupHeader.tabsBackground": "#14171a",
    "panel.background": "#0c0e10",
    "panel.border": "#262b31",
    "panelTitle.activeBorder": "#45e08c",
    "focusBorder": "#45e08c80",
    "button.background": "#45e08c",
    "button.foreground": "#0c0e10",
    "list.activeSelectionBackground": "#143325",
    "list.hoverBackground": "#1a1e22",
    "input.background": "#14171a",
    "dropdown.background": "#14171a",
    "terminal.background": "#0c0e10",
    "terminal.foreground": "#d7dde3",
    "terminalCursor.foreground": "#45e08c",
    "terminal.selectionBackground": "#143325",
    "terminal.ansiBlack": "#14171a",
    "terminal.ansiRed": "#ff6166",
    "terminal.ansiGreen": "#45e08c",
    "terminal.ansiYellow": "#f5c542",
    "terminal.ansiBlue": "#5fd0f2",
    "terminal.ansiMagenta": "#c792ea",
    "terminal.ansiCyan": "#5fd0f2",
    "terminal.ansiWhite": "#d7dde3",
    "terminal.ansiBrightBlack": "#66717c",
    "terminal.ansiBrightRed": "#ffb3b6",
    "terminal.ansiBrightGreen": "#63f08b",
    "terminal.ansiBrightYellow": "#f8d77a",
    "terminal.ansiBrightBlue": "#9ae3f7",
    "terminal.ansiBrightMagenta": "#dbb0f5",
    "terminal.ansiBrightCyan": "#a5e3ff",
    "terminal.ansiBrightWhite": "#f4f7f9"
  },
  "editor.fontFamily": "ui-monospace, 'JetBrains Mono', 'Cascadia Code', 'Fira Code', Menlo, monospace",
  "terminal.integrated.fontFamily": "ui-monospace, 'JetBrains Mono', 'Cascadia Code', 'Fira Code', Menlo, monospace",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.defaultProfile.linux": "stegsuite",
  "terminal.integrated.profiles.linux": {
    "stegsuite": {
      "path": "bash",
      "args": [
        "-l"
      ],
      "icon": "search"
    },
    "rev": {
      "path": "/usr/local/bin/ctf-rev-shell",
      "icon": "debug"
    }
  },
  "terminal.integrated.cwd": "/data/projects",
  "files.exclude": {
    "**/__pycache__": true
  },
  "workbench.editorAssociations": {
    "*.bin": "hexEditor.hexedit",
    "*.dat": "hexEditor.hexedit",
    "*.db": "sqlite-viewer.view",
    "*.sqlite": "sqlite-viewer.view",
    "*.pdf": "pdf.preview"
  },
  "security.workspace.trust.enabled": false,
  "telemetry.telemetryLevel": "off",
  "extensions.autoCheckUpdates": false,
  "update.mode": "none",
  "chat.disableAIFeatures": true,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "explorer.sortOrder": "modified",
  "git.enabled": false,
  "git.autoRepositoryDetection": false,
  "outline.showVariables": false,
  "workbench.layoutControl.enabled": false,
  "workbench.iconTheme": "material-icon-theme",
  "files.associations": {
    "*.out": "log",
    "*.asm": "asm-intel-x86-generic",
    "*.s": "asm-intel-x86-generic",
    "*.S": "asm-intel-x86-generic",
    "*.smali": "smali",
    "*.sol": "solidity",
    "*.j2": "jinja",
    "*.ps1": "powershell",
    "*.vbs": "vb",
    "*.eml": "log"
  }
}
