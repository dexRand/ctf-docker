// zellij — Terminale CTF (:19022). Stessi colori della SPA StegSuite.
//   Alt+n nuovo pane   Alt+t nuova tab   Alt+frecce focus   Ctrl+s scroll
default_shell "bash"
default_layout "ctf"
theme "ctf"
pane_frames false
show_startup_tips false
show_release_notes false
copy_on_select true

themes {
    ctf {
        fg "#d7dde3"
        bg "#262b31"
        black "#0c0e10"
        red "#ff6166"
        green "#45e08c"
        yellow "#f5c542"
        blue "#5fd0f2"
        magenta "#c792ea"
        cyan "#5fd0f2"
        white "#f4f7f9"
        orange "#f5c542"
    }
}
