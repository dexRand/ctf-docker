# =============================================================================
# CTF Toolbox — configurazione. Copia in `.env` (o lascia fare a `./ctf up`).
# Fascia porte 19000+ scelta per non collidere con altri stack.
# =============================================================================

# ---------------------------------------------------------------- Porte host
APERISOLVE_PORT=19000
HOMEPAGE_PORT=19001
CYBERCHEF_PORT=19002
MITMWEB_UI_PORT=19003
MITMPROXY_PORT=19004
# Password per la GUI di mitmweb (utente: qualunque, password: questa)
MITMWEB_PASSWORD=mitm
ZAP_UI_PORT=19005
ZAP_PROXY_PORT=19006
SPIDERFOOT_PORT=19007
WIRESHARK_HTTP_PORT=19008
WIRESHARK_HTTPS_PORT=19009
SAGEMATH_PORT=19010
ITTOOLS_PORT=19011
FILEBROWSER_PORT=19012
STEGSUITE_PORT=19014
# profondità di ricorsione sugli archivi annidati (default 6; alza per es.
# a 1000 per challenge tipo "like1000", ma è lento)
MAX_DEPTH=6
# quanti tool pesanti (binwalk/foremost/7z/...) eseguire in parallelo
HEAVY_TOOLS=1
# se impostata, protegge API + WebSocket/terminale (header X-API-Key o ?key=).
# Nella GUI impostala in localStorage: localStorage.setItem('stegsuite_api_key','...')
# STEGSUITE_API_KEY=
# tetto massimo per upload (singolo progetto, somma dei file)
MAX_UPLOAD_MB=1024
# rate limiting API: richieste al minuto per IP (0 = disattivato) e burst
# consentito. Serve se esporsi oltre localhost.
RATE_LIMIT_RPM=0
RATE_LIMIT_BURST=0
# cancellazione automatica dei progetti dopo N giorni (0 = mai)
RETENTION_DAYS=0
# OCR di tesseract: lingua base "eng"; "ita" viene provata come fallback solo se
# la passata in inglese non trova una flag (il pack è incluso nell'immagine)
OCR_LANGS=eng
OCR_EXTRA_LANGS=ita
# cracking: tetto upload wordlist (MB), regole hashcat ("" per disattivare),
# e budget CPU in secondi per il crack ZIP (0 = nessun limite)
MAX_WORDLIST_MB=512
HASHCAT_RULES=best64
CRACK_BUDGET_S=0
RQ_DASHBOARD_PORT=19181

# ------------------------------------------------------------ Deep triage
# GUI web del triage (solo localhost). Le wordlist in ./wordlists/ vengono
# montate su /wordlists e ordinate automaticamente dalla più piccola alla più
# grande; la rockyou completa è già inclusa nell'immagine.
TRIAGE_WEB_PORT=19013

# Host ammessi da Homepage (aggiungi l'IP della macchina se accedi da remoto)
HOMEPAGE_ALLOWED_HOSTS=localhost:19001,127.0.0.1:19001

# Utente/gruppo per i container LinuxServer (Wireshark)
PUID=1000
PGID=1000
TZ=Europe/Rome

# =============================================================================
# AperiSolve (https://github.com/Zeecka/AperiSolve)
# =============================================================================
PROJECT_VERSION=3.1.3
WEB_WORKERS=8
MAX_CONTENT_LENGTH=3145728
MAX_PENDING_TIME=600
MAX_STORE_TIME=259200
# ATTENZIONE: 1 cancella DB e risultati a ogni avvio. Lasciare 0.
CLEAR_AT_RESTART=0
SKIP_IHDR_FILL=0
REMOVAL_MIN_AGE_SECONDS=300
CLEANUP_INTERVAL_SECONDS=900

# Ads: vuoto = nessuna pubblicità
GOOGLE_ADS_TXT=
CUSTOM_EXTERNAL_SCRIPT=

# URL pubblico base (canonical/sitemap)
SITE_BASE_URL=

FLASK_DEBUG=0

# Redis / database
REDIS_URL=redis://redis:6379/0
RQ_DASHBOARD_REDIS_URL=redis://redis:6379/0
RATELIMIT_STORAGE_URI=redis://redis:6379/1
POSTGRES_DB=aperisolve
POSTGRES_USER=aperiuser
POSTGRES_PASSWORD=aperipass
DB_URI=postgresql://aperiuser:aperipass@postgres:5432/aperisolve

# Sentry (opzionale)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_RELEASE=1.0.0
SENTRY_ENVIRONMENT=development
