# Segreti / configurazione locale
.env

# Stato locale dei tool
config/zap/*
!config/zap/.gitkeep

# File generati a runtime da Homepage
config/homepage/logs/
config/homepage/kubernetes.yaml
config/homepage/docker.yaml
config/homepage/bookmarks.yaml

# StegSuite app data (SQLite + progetti)
appdata/

# StegSuite frontend build artifacts
app/frontend/node_modules/
app/frontend/dist/

# Deep triage: dati di lavoro e wordlist pesanti
data/
wordlists/*
!wordlists/.gitkeep
# wordlist "più usate" versionate (piccole)
!wordlists/passwords.txt
!wordlists/500-worst-passwords.txt
!wordlists/probable-v2_top-1575.txt
!wordlists/10k-most-common.txt
!wordlists/darkweb2017_top-10000.txt
!wordlists/rockyou-75.txt

# Python
__pycache__/
*.pyc

# OS / editor
.DS_Store
*.swp
